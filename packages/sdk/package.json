    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@oversightreconcile/core": "0.1.0",
    "@oversightreconcile/skills": "0.1.0",
    "@oversightreconcile/plugins": "0.1.0",
    "@oversightreconcile/channels": "0.1.0",
    "@oversightreconcile/providers": "0.1.0",
    "@oversightreconcile/memory": "0.1.0"
  },
  "overrides": {
    "postcss": "8.5.18",
    "tar": "7.5.21",
    "sharp": "0.35.5",
    "undici": "8.12.2",
    "js-yaml": "4.3.2",
    "smol-toml": "1.7.1",
    "follow-redirects": "1.16.2",
    "axios": "1.20.0",
    "fast-uri": "4.1.4",
    "ip-address": "10.3.1",
    "@azure/msal-node": "7.1.0",
    "@opentelemetry/propagator-jaeger": "2.9.0",
    "markdown-it": "14.3.3",
    "source-map-js": "1.2.2",
    "minimatch": "11.1.0"
  }
